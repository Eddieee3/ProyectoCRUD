<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.desarrollo.proyectocrud.controller.ProductosController">

    <children>

        <VBox spacing="15.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.topAnchor="20.0">

            <padding>
                <Insets bottom="10"
                        left="10"
                        right="10"
                        top="10"/>
            </padding>

            <!-- TITULO -->
            <Label text="Gestión de productos"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>


            <!-- FORMULARIO DE PRODUCTOS -->
            <GridPane hgap="10"
                      vgap="10">

                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>


                <Label text="Código:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtCodigo"
                           promptText="Ej: P001"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>


                <Label text="Nombre:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtNombre"
                           promptText="Nombre del producto"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"/>


                <Label text="Precio:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtPrecio"
                           promptText="0.00"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>


                <Label text="Stock:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtStock"
                           promptText="0"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>


                <Label text="Categoría:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <ComboBox fx:id="cmbCategoria"
                          prefWidth="180"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>


                <Label text="Marca:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"/>

                <ComboBox fx:id="cmbMarca"
                          prefWidth="180"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="2"/>


                <Label text="Fecha:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <DatePicker fx:id="dpFecha"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>


                <Label text="Descripción:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="txtDescripcion"
                           promptText="Descripción opcional"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="3"/>

            </GridPane>


            <!-- BOTONES CRUD -->
            <HBox spacing="10">

                <Button fx:id="btnNuevo"
                        text="Nuevo"
                        onAction="#nuevoProducto"/>

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#guardarProducto"/>

                <Button fx:id="btnActualizar"
                        text="Actualizar"
                        onAction="#actualizarProducto"/>

                <Button fx:id="btnEliminar"
                        text="Eliminar"
                        onAction="#eliminarProducto"/>

            </HBox>


            <Separator/>


            <!-- TITULO BUSQUEDA -->
            <Label text="Búsqueda y filtros"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>


            <!-- FILTROS -->
            <GridPane hgap="10"
                      vgap="10">

                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>


                <Label text="Código o nombre:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtBuscar"
                           promptText="Buscar..."
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>


                <Label text="Categoría:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="cmbFiltroCategoria"
                          prefWidth="180"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="0"/>


                <Label text="Desde:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <DatePicker fx:id="dpDesde"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>


                <Label text="Hasta:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>

                <DatePicker fx:id="dpHasta"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="1"/>


                <Label text="Precio mínimo:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtPrecioMin"
                           promptText="0.00"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>


                <Label text="Precio máximo:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtPrecioMax"
                           promptText="0.00"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="2"/>


                <CheckBox fx:id="chkConStock"
                          text="Solo productos con existencia"
                          GridPane.columnIndex="0"
                          GridPane.columnSpan="2"
                          GridPane.rowIndex="3"/>


                <Label text="Ordenar por:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="3"/>

                <ComboBox fx:id="cmbOrdenar"
                          prefWidth="180"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="3"/>

            </GridPane>


            <!-- BOTONES BUSQUEDA -->
            <HBox spacing="10">

                <Button fx:id="btnBuscar"
                        text="Buscar"
                        onAction="#buscarProductos"/>

                <Button fx:id="btnLimpiarFiltros"
                        text="Limpiar filtros"
                        onAction="#limpiarFiltros"/>

            </HBox>


            <!-- TABLA PRODUCTOS -->
            <TableView fx:id="tablaProductos"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colNombre"
                                 text="Nombre"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colCategoria"
                                 text="Categoría"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colMarca"
                                 text="Marca"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colPrecio"
                                 text="Precio"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colStock"
                                 text="Stock"
                                 prefWidth="80"/>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha creación"
                                 prefWidth="150"/>

                </columns>

            </TableView>

        </VBox>

    </children>

</AnchorPane>